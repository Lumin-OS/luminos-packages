# The key LuminOS's package repository is signed with, for pacman-key.
# luminos-base depends on it, so every install trusts the repository. The
# live ISO imports it at boot, and Dawn's offline cleanup runs
# `pacman-key --populate archlinux luminos`.
#
# The key expires on 2029-10-17. Before then, extend it
# (gpg --quick-set-expire), export luminos.gpg again and release a new
# pkgver, or pacman starts rejecting the repository's signatures.

pkgname=luminos-keyring
pkgver=20261018
pkgrel=1
pkgdesc='LuminOS repository signing key'
arch=('any')
url='https://github.com/Lumin-OS/luminos-packages'
license=('GPL-3.0-or-later')
install=luminos-keyring.install
source=(luminos.gpg luminos-trusted)
sha256sums=('e2319c89cbd3b58993be3aa2182e35a79e62278e99007995f9bcf5e6265e0d73'
            '2e6173352ca4cad05b7b664a4084f9516ce27b2c6e6ae4ccca0290e1865dd1e0')

package() {
  install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings/" luminos.gpg luminos-trusted
}
